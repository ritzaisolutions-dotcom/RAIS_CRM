    {
      "parameters": {
        "jsCode": "// Filter: hat Email, email_1_sent ist leer, nicht unsubscribed\nconst filtered = [];\n\nfor (const item of $input.all()) {\n  const email = (item.json.email || '').trim();\n  const sent = (item.json.email_1_sent || '').trim();\n  const unsub = (item.json.unsubscribed || '').trim().toLowerCase();\n  const reply = (item.json.reply_received || '').trim().toLowerCase();\n  \n  if (\n    email && \n    email !== 'NA' && \n    email !== 'na' && \n    email.includes('@') &&\n    !sent &&\n    unsub !== 'ja' &&\n    reply !== 'ja'\n  ) {\n    filtered.push(item);\n  }\n}\n\nif (filtered.length === 0) {\n  return [{ json: { _empty: true, message: 'Keine neuen Leads für Email 1' } }];\n}\n\nreturn filtered;"
      },
