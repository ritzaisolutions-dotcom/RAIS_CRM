    {
      "parameters": {
        "jsCode": "const minDays = $('Config').first().json.min_days_since_email2;\nconst now = new Date();\nconst filtered = [];\n\nfor (const item of $input.all()) {\n  const email2Sent = (item.json.email_2_sent || '').trim();\n  const followupSent = (item.json.followup_sent || '').trim();\n  const unsub = (item.json.unsubscribed || '').trim().toLowerCase();\n  const reply = (item.json.reply_received || '').trim().toLowerCase();\n  const email = (item.json.email || '').trim();\n\n  if (\n    email2Sent &&\n    !followupSent &&\n    unsub !== 'ja' &&\n    reply !== 'ja' &&\n    email &&\n    email !== 'NA' &&\n    email.includes('@')\n  ) {\n    const sentDate = new Date(email2Sent);\n    const daysSince = Math.floor((now - sentDate) / (1000 * 60 * 60 * 24));\n    \n    if (daysSince >= minDays) {\n      filtered.push(item);\n    }\n  }\n}\n\nif (filtered.length === 0) {\n  return [{ json: { _empty: true, message: 'Keine Leads für Follow Up 2' } }];\n}\n\nreturn filtered;"
      },
