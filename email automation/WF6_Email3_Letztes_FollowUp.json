    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst person = item.person_name || item.person || '';\nconst nachname = (person && person !== 'NA' && person !== 'na')\n  ? person.split(' ').slice(-1)[0]\n  : null;\n\nconst anrede = nachname\n  ? `Sehr geehrter Herr ${nachname}`\n  : 'Sehr geehrte Damen und Herren';\n\nconst firma = item.company_name || 'Ihr Betrieb';\nconst email = item.email || '';\nconst row = item.row_number;\nconst email1Subject = (item.email_1_subject || '').trim();\n\nconst subject = email1Subject ? `Re: ${email1Subject}` : 'Re: Letzte Nachricht';\n\nconst body = `${anrede},\n\nletzte Nachricht von mir — ich schließe diese Runde ab.\n\nFalls Kostenrechner + Online-Terminbuchung für ${firma} aktuell Sinn macht, melden Sie sich diese Woche noch. Danach bin ich mit anderen Projekten ausgebucht.\n\nDemo: https://fliesen-weber.vercel.app/\n\nBeste Grüße\nKevin Ritz`;\n\nreturn [{\n  json: {\n    email_to: email,\n    email_subject: subject,\n    email_body: body,\n    row_number: row\n  }\n}];"
      },
