    {
      "parameters": {
        "jsCode": "const minDays = $('Config').first().json.min_days_since_email1;\nconst now = new Date();\nconst filtered = [];\n\nfor (const item of $input.all()) {\n  const email1Sent = (item.json.email_1_sent || '').trim();\n  const email2Sent = (item.json.email_2_sent || '').trim();\n  const unsub = (item.json.unsubscribed || '').trim().toLowerCase();\n  const reply = (item.json.reply_received || '').trim().toLowerCase();\n  const email = (item.json.email || '').trim();\n\n  // Muss: email_1 gesendet, email_2 noch nicht, nicht unsubscribed, nicht geantwortet\n  if (\n    email1Sent &&\n    !email2Sent &&\n    unsub !== 'ja' &&\n    reply !== 'ja' &&\n    email &&\n    email !== 'NA' &&\n    email.includes('@')\n  ) {\n    const sentDate = new Date(email1Sent);\n    const daysSince = Math.floor((now - sentDate) / (1000 * 60 * 60 * 24));\n    \n    if (daysSince >= minDays) {\n      filtered.push(item);\n    }\n  }\n}\n\nif (filtered.length === 0) {\n  return [{ json: { _empty: true, message: 'Keine Leads für Follow Up 1' } }];\n}\n\nreturn filtered;"
      },
