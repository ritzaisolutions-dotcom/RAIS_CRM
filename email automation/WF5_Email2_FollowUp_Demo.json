    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst person = item.person_name || item.person || '';\nconst nachname = (person && person !== 'NA' && person !== 'na')\n  ? person.split(' ').slice(-1)[0]\n  : null;\n\nconst anrede = nachname\n  ? `Sehr geehrter Herr ${nachname}`\n  : 'Sehr geehrte Damen und Herren';\n\nconst firma = item.company_name || 'Ihr Betrieb';\nconst email = item.email || '';\nconst row = item.row_number;\nconst email1Subject = (item.email_1_subject || '').trim();\n\n// Re: gleicher Thread\nconst subject = email1Subject ? `Re: ${email1Subject}` : 'Re: Anfragen auch nach Feierabend?';\n\nconst body = `${anrede},\n\nkurze Nachfrage — hatten Sie Zeit in die Demo reinzuschauen?\n\nFalls nicht: hier nochmal der Link — https://fliesen-weber.vercel.app/\n\nDer Kostenrechner lässt sich komplett auf Ihre Preise anpassen. Kein Abo, keine monatlichen Kosten — einmaliges Festpreis-Projekt.\n\nWäre einen kurzen Call wert?\n\nBeste Grüße\nKevin Ritz\nRitz AI Solutions\nritz-ai.solutions | +49 151 2975 5134 | kevin@ritz-ai.solutions`;\n\nreturn [{\n  json: {\n    email_to: email,\n    email_subject: subject,\n    email_body: body,\n    row_number: row\n  }\n}];"
      },
