        "body": "={{ JSON.stringify({ wf: 'wf3', stadt: $('Config').item.json.stadt, status: 'done', finished_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [912, -384],
      "id": "notify-wf3",
      "name": "Notify wf_runs"
    },
