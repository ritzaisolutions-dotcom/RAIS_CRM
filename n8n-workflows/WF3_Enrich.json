    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.0-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.0-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Company Name: {{ $json.Name }}\nWebsite: {{ $json.website }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": { "googleSearch": true },
        "options": {
          "systemMessage": "###ROLE\nYou are a research expert helping us find the business owner of a German tile/flooring contractor (Fliesenleger/Bodenleger) and one specific observation about their business.\n\n###TASK\n1. Find the owner/director name, email, and social media\n2. Visit their website and identify ONE specific detail about their business — something concrete and visible (e.g. they have a stone warehouse, they specialize in natural stone, they show 8 employees on their team page, they have no contact form, their site looks like it's from 2010, they only list a phone number)\n\n###OUTPUT\nRespond ONLY with valid JSON, no markdown, no explanation:\n{\n  \"Company Name\": \"Fliesen Weber\",\n  \"besonderheit\": \"Keine Kontaktmöglichkeit außer Telefon auf der Website\",\n  \"Person Name\": [\n    {\n      \"name\": \"Max Weber\",\n      \"title\": \"Inhaber\",\n      \"email\": \"max@fliesen-weber.de\",\n      \"LinkedIn\": \"NA\",\n      \"Instagram\": \"NA\",\n      \"Twitter\": \"NA\",\n      \"Facebook\": \"NA\"\n    }\n  ]\n}\n\n###IMPORTANT\n- besonderheit must be ONE sentence, specific and factual, in German\n- If no website exists, besonderheit = \"Keine Website vorhanden\"\n- Output ONLY the JSON object, nothing else"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [1072, -16],
      "id": "gemini-wf3",
      "name": "Gemini Research",
      "credentials": {
        "googlePalmApi": {
          "id": "Ewff9bZdQEgs99XA",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ext-out",
              "name": "output",
              "value": "={{ $json.content?.parts?.[0]?.text || $json.output || $json.text || '' }}",
              "type": "string"
            },
            {
              "id": "ext-id",
              "name": "record_id",
              "value": "={{ $('Prep Fields').item.json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1296, -16],
      "id": "ext-wf3",
      "name": "Extract Output"
    },
    {
      "parameters": {
        "jsCode": "const allItems = [];\n\nfor (const item of $input.all()) {\n  try {\n    let rawText = item.json.output || '';\n    if (!rawText) throw new Error('No output text');\n    const jsonString = rawText.replace(/```json|```/g, '').trim();\n    const parsedData = JSON.parse(jsonString);\n    const besonderheit = parsedData['besonderheit'] || 'NA';\n    const people = parsedData['Person Name'] || [];\n    const person = people[0] || {};\n    allItems.push({\n      json: {\n        record_id: item.json.record_id,\n        besonderheit: besonderheit,\n        person_name: person.name || null,\n        kontakt_titel: person.title || null,\n        email: (person.email && person.email !== 'NA') ? person.email : null,\n        instagram: (person.Instagram && person.Instagram !== 'NA') ? person.Instagram : null\n      }\n    });\n  } catch (error) {\n    allItems.push({\n      json: {\n        record_id: item.json.record_id,\n        besonderheit: null,\n        person_name: null,\n        email: null,\n        _parse_error: error.message\n      }\n    });\n  }\n}\n\nreturn allItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, -16],
      "id": "parse-wf3",
      "name": "Parse Gemini JSON"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').item.json.sb_url }}/crm_contacts?id=eq.{{ $json.record_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $('Config').item.json.sb_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Config').item.json.sb_key }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ besonderheit: $json.besonderheit || null, kontakt: $json.person_name || null, email: $json.email || null, instagram: $json.instagram || null, enriched: true }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1744, -16],
      "id": "update-wf3",
