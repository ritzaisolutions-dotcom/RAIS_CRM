    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst cfg = $('Config').item.json;\n\nconst person = item.kontakt || item.person || item.person_name || 'Inhaber';\nconst besonderheit = item.besonderheit || '';\nconst website = item.website || 'nicht verfügbar';\nconst anlass = cfg.anlass || null;\nconst notiz = cfg.notiz || '';\n\nconst anlassMap = {\n  'keine_website': 'Keine eigene Website vorhanden',\n  'veraltet': 'Website wirkt veraltet (ggf. vor 2018 erstellt)',\n  'kein_kalkulator': 'Kein Online-Kostenrechner oder Angebotsrechner',\n  'kein_formular': 'Kein Kontaktformular — nur Telefon',\n  'nur_telefon': 'Nur per Telefon erreichbar',\n  'kein_termin': 'Keine Online-Terminbuchung',\n  'mobile': 'Schlechte Darstellung auf Mobilgeräten',\n  'kein_google': 'Kein oder schwacher Google-Auftritt',\n  'sonstiges': notiz || besonderheit\n};\n\nconst anlassHint = anlass ? (anlassMap[anlass] || besonderheit) : besonderheit;\n\nconst prompt = `###ROLE\\nDu bist ein deutscher Cold-Email-Spezialist für lokale Fliesenleger-Betriebe.\\n\\n###TASK\\nSchreibe NUR diese 3 Felder für eine Cold Email:\\n1. subject: Betreffzeile (micro-yes, max 8 Wörter, kein Marketing-Speak)\\n2. observation: 1 Satz — öffentlich sichtbares UX Problem auf ihrer Website, kein Vorwurf\\n3. mechanics: 1 Satz — nachvollziehbare Konsequenz für einen zahlbereiten Kunden\\n\\n###REGELN\\n- Alles in einem Klick öffentlich verifizierbar\\n- Kein Marketing-Speak, keine Floskeln\\n- Sprache: Deutsch, Sie-Form\\n- KEINE Anrede in observation oder mechanics\\n- Starte observation NICHT mit \"Ich\" oder dem Firmennamen\\n\\n###INPUT\\n- Website: ${website}\\n- Beobachtung/Anlass: ${anlassHint}\\n- Notizen: ${notiz}\\n\\n###OUTPUT — NUR gültiges JSON, kein Markdown:\\n{\"subject\": \"...\", \"observation\": \"...\", \"mechanics\": \"...\"}`;\n\nconst body = {\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 300,\n  messages: [{ role: 'user', content: prompt }]\n};\n\nreturn [{ json: { ...item, claude_request_body: JSON.stringify(body) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 448],
