      "credentials": {
        "httpHeaderAuth": {
          "id": "078Xmif1japW9J1a",
          "name": "RAIS anthropic api key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $('Build Claude Prompt').first().json;\nconst rawResponse = $input.first().json;\nconst cfg = $('Config').item.json;\n\nlet claudeJson = {\n  subject: 'Kundenanfragen außerhalb Ihrer Erreichbarkeit',\n  observation: 'Auf Ihrer Website ist Telefon die einzige Möglichkeit, Sie zu kontaktieren.',\n  mechanics: 'Kunden die außerhalb Ihrer Erreichbarkeit anrufen und niemanden erreichen, gehen zur Konkurrenz.'\n};\n\ntry {\n  const rawText = rawResponse.content[0].text.trim().replace(/```json|```/g, '').trim();\n  claudeJson = JSON.parse(rawText);\n} catch (e) {}\n\nconst person = item.kontakt || item.person || '';\nconst firma = item.firma || 'Ihr Betrieb';\nconst email = item.email || '';\n\nconst nachname = (person && person !== 'NA' && person !== 'na')\n  ? person.split(' ').slice(-1)[0] : null;\nconst anrede = nachname ? `Sehr geehrter Herr ${nachname}` : 'Sehr geehrte Damen und Herren';\n\nconst subject = claudeJson.subject || 'Kundenanfragen außerhalb Ihrer Erreichbarkeit';\nconst bodyText = `${anrede},\\n\\n${claudeJson.observation}\\n\\n${claudeJson.mechanics}\\n\\nIch würde Ihnen gerne eine Demo vorbereiten — eine Version Ihrer Website mit Kostenrechner und Terminbuchung, damit Kunden auch dann anfragen können, wenn Sie auf der Baustelle sind.\\n\\nDemo ansehen: ${cfg.demo_url}\\n\\nWäre das einen kurzen Blick wert, ja oder nein?\\n\\nFalls nicht passend, ignorieren Sie diese Email.\\n\\nBeste Grüße\\nKevin Ritz\\nRitz AI Solutions\\nritz-ai.solutions | +49 151 2975 5134 | kevin@ritz-ai.solutions`;\n\nreturn [{\n  json: {\n    email_to: email,\n    email_subject: subject,\n    email_body: bodyText,\n    contact_id: item.id,\n    firma: firma,\n    preview_only: cfg.preview_only\n  }\n}];"
      },
