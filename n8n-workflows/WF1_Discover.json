{
  "name": "WF1 — Lead Discovery (Supabase)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf1-discover",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1280, 1040],
      "id": "wh-wf1",
      "name": "Webhook"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1280, 880],
      "id": "mt-wf1",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "jsCode": "const _hdrs = ($input.first().json.headers || {});\nconst _expected = $env.N8N_PROXY_SECRET;\nconst _got = _hdrs['x-crm-proxy-secret'] || _hdrs['X-CRM-Proxy-Secret'] || '';\nif (!_expected || _got !== _expected) throw new Error('Unauthorized');\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1136, 1040],
      "id": "auth-wf1",
      "name": "Proxy Secret Check"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-api",
              "name": "Google_Maps_API_Key",
              "value": "={{ $env.GOOGLE_MAPS_API_KEY }}",
              "type": "string"
            },
            {
              "id": "cfg-query",
              "name": "query",
              "value": "={{ $json.body?.query || $json.query || 'Fliesenleger' }}",
              "type": "string"
            },
            {
              "id": "cfg-stadt",
              "name": "stadt",
              "value": "={{ $json.body?.stadt || $json.stadt || 'München' }}",
              "type": "string"
            },
            {
              "id": "cfg-radius",
              "name": "radius",
              "value": "={{ $json.body?.radius || $json.radius || 10000 }}",
              "type": "number"
            },
            {
              "id": "cfg-sb-url",
              "name": "sb_url",
              "value": "https://qdywaenmojdxhfxqbvun.supabase.co/rest/v1",
              "type": "string"
            },
            {
              "id": "cfg-sb-key",
              "name": "sb_key",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1008, 1040],
      "id": "cfg-wf1",
      "name": "Config"
    },
    {
      "parameters": {
        "url": "https://maps.googleapis.com/maps/api/geocode/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "address", "value": "={{ $('Config').item.json.stadt }}, Germany" },
            { "name": "key", "value": "={{ $('Config').item.json.Google_Maps_API_Key }}" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [-784, 1040],
      "id": "geo-wf1",
      "name": "GET Coordinates"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "loc-lat",
              "name": "lat",
              "value": "={{ $json.results[0].geometry.location.lat }}",
              "type": "number"
            },
            {
              "id": "loc-lng",
              "name": "lng",
              "value": "={{ $json.results[0].geometry.location.lng }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-560, 1040],
      "id": "loc-wf1",
      "name": "Extract Location"
    },
    {
      "parameters": {
        "url": "https://places.googleapis.com/v1/places:searchText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Goog-Api-Key", "value": "={{ $('Config').item.json.Google_Maps_API_Key }}" },
            { "name": "X-Goog-FieldMask", "value": "places.id,places.displayName,places.formattedAddress,places.rating,places.userRatingCount,places.websiteUri,places.nationalPhoneNumber,nextPageToken" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ textQuery: $('Config').item.json.query, locationBias: { circle: { center: { latitude: $json.lat, longitude: $json.lng }, radius: $('Config').item.json.radius } }, pageSize: 20 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [-336, 1040],
      "id": "places-wf1",
      "name": "GET Places"
    },
    {
      "parameters": {
        "fieldToSplitOut": "places",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-112, 1040],
      "id": "split-wf1",
      "name": "Split Out"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "map-id",
              "name": "place_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "map-name",
              "name": "firma",
              "value": "={{ $json.displayName?.text || $json.displayName }}",
              "type": "string"
            },
            {
              "id": "map-addr",
              "name": "adresse",
              "value": "={{ $json.formattedAddress }}",
              "type": "string"
            },
            {
              "id": "map-phone",
              "name": "telefon",
              "value": "={{ $json.nationalPhoneNumber }}",
              "type": "string"
            },
            {
              "id": "map-rating",
              "name": "rating",
              "value": "={{ $json.rating }}",
              "type": "number"
            },
            {
              "id": "map-reviews",
              "name": "reviews",
              "value": "={{ $json.userRatingCount }}",
              "type": "number"
            },
            {
              "id": "map-website",
              "name": "website",
              "value": "={{ $json.websiteUri }}",
              "type": "string"
            },
            {
              "id": "map-stadt",
              "name": "stadt",
              "value": "={{ $('Config').item.json.stadt }}",
              "type": "string"
            },
            {
              "id": "map-gewerk",
              "name": "gewerk",
              "value": "={{ $('Config').item.json.query }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [112, 1040],
      "id": "map-wf1",
      "name": "Map Fields"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.sb_url }}/crm_contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Config').item.json.sb_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Config').item.json.sb_key }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ place_id: $json.place_id, firma: $json.firma, adresse: $json.adresse, telefon: $json.telefon, website: $json.website, rating: $json.rating || 0, reviews: $json.reviews || 0, stadt: $json.stadt, gewerk: $json.gewerk, status: 'neu' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [336, 1040],
      "id": "upsert-wf1",
      "name": "Upsert to Supabase"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.sb_url }}/wf_runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Config').item.json.sb_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Config').item.json.sb_key }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ wf: 'wf1', stadt: $('Config').item.json.stadt, status: 'done', finished_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [560, 960],
      "id": "notify-wf1",
      "name": "Notify wf_runs"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"wf\": \"wf1\", \"stadt\": \"{{ $('Config').item.json.stadt }}\" }"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [784, 960],
      "id": "resp-wf1",
      "name": "Respond to Webhook"
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": { "main": [[{ "node": "Proxy Secret Check", "type": "main", "index": 0 }]] },
    "Proxy Secret Check": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Manual Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "GET Coordinates", "type": "main", "index": 0 }]] },
    "GET Coordinates": { "main": [[{ "node": "Extract Location", "type": "main", "index": 0 }]] },
    "Extract Location": { "main": [[{ "node": "GET Places", "type": "main", "index": 0 }]] },
    "GET Places": { "main": [[{ "node": "Split Out", "type": "main", "index": 0 }]] },
    "Split Out": { "main": [[{ "node": "Map Fields", "type": "main", "index": 0 }]] },
    "Map Fields": { "main": [[{ "node": "Upsert to Supabase", "type": "main", "index": 0 }]] },
    "Upsert to Supabase": { "main": [[{ "node": "Notify wf_runs", "type": "main", "index": 0 }]] },
    "Notify wf_runs": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {
