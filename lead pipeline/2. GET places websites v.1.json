    {
      "parameters": {
        "jsCode": "// WF2 Qualifizierungs-Score — Fliesenleger Edition (MAXIMUM LEADS)\nconst item = $input.first().json.results || $input.first().json;\n\nconst rating = parseFloat(item.rating) || 0;\nconst reviewCount = parseInt(item.user_ratings_total) || 0;\nconst hasWebsite = !!item.website;\nconst website = (item.website || '').toLowerCase();\nconst businessName = (item.name || '').toLowerCase();\n\n// ========== KETTEN & FRANCHISE BLACKLIST ==========\nconst chainKeywords = [\n  'fliesen kemmler', 'hornbach', 'bauhaus', 'obi', 'toom', 'hagebau',\n  'baumarkt', 'globus', 'bauking', 'raab karcher',\n  'franchise', 'filialen', 'standorte deutschlandweit',\n  'nur b2b', 'ausschließlich gewerblich', 'generalunternehmer exklusiv'\n];\n\nconst isChain = chainKeywords.some(k => \n  businessName.includes(k) || website.includes(k)\n);\n\n// ========== AGGREGATOR & SOCIAL MEDIA URLs ==========\nconst aggregatorURLs = [\n  'facebook.com', 'instagram.com', 'lieferando.de', 'speisekartenweb.de',\n  'gelbeseiten.de', 'golocal.de', '11880.com', 'yelp.de'\n];\n\nconst isSocialOrAggregator = aggregatorURLs.some(url => website.includes(url));\n\n// ========== SCORING LOGIC ==========\nlet score = 0;\nlet reasons = [];\n\n// Website Status dokumentieren\nif (!hasWebsite) {\n  reasons.push('Keine Website');\n} else if (isSocialOrAggregator) {\n  reasons.push('Nur Social/Aggregator');\n} else {\n  reasons.push('Hat Website');\n}\n\n// Rating (3.5+ = qualified) — SEHR LOCKER\nif (rating >= 3.5) {\n  score += 50;\n  reasons.push('Rating OK');\n}\n\n// Review Count (5+ = qualified) — SEHR LOCKER\nif (reviewCount >= 10) {\n  score += 50;\n  reasons.push('Aktiv');\n}\n\n// Disqualifizierung NUR bei Ketten\nif (isChain) {\n  score = -99;\n  reasons = ['KETTE/FRANCHISE - SKIP'];\n}\n\n// ========== RETURN ==========\nreturn {\n  json: {\n    ...item,\n    lead_score: score,\n    score_reasons: reasons.join(', '),\n    QUALIFIED: (score >= 100 && !isChain) ? '1' : '0'\n  }\n};"
      },
