    {
      "parameters": {
        "jsCode": "const allItems = [];\n\nfor (const item of $input.all()) {\n  try {\n    let rawText = item.json.output || item.json.text || \"\";\n\n    if (!rawText) {\n      throw new Error(\"No output text found in the input node.\");\n    }\n\n    const jsonString = rawText.replace(/```json|```/g, '').trim();\n    const parsedData = JSON.parse(jsonString);\n    \n    const companyName = parsedData[\"Company Name\"] || \"Unknown\";\n    const besonderheit = parsedData[\"besonderheit\"] || \"NA\";\n    const people = parsedData[\"Person Name\"] || [];\n\n    for (const person of people) {\n      allItems.push({\n        json: {\n          company_name: companyName,\n          besonderheit: besonderheit,\n          person_name: person.name || \"NA\",\n          title: person.title || \"NA\",\n          email: person.email || \"NA\",\n          linkedin: person.LinkedIn || \"NA\",\n          instagram: person.Instagram || \"NA\",\n          twitter: person.Twitter || \"NA\",\n          facebook: person.Facebook || \"NA\"\n        }\n      });\n    }\n  } catch (error) {\n    allItems.push({\n      json: {\n        error: \"Failed to parse Gemini output\",\n        details: error.message,\n        input_received: item.json\n      }\n    });\n  }\n}\n\nreturn allItems;"
      },
