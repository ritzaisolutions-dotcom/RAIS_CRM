    {
      "parameters": {
        "jsCode": "const minDays = $('Config').item.json.min_days_since_email1;\nconst now = new Date();\n\nconst filtered = [];\nfor (const item of $input.all()) {\n  const email = (item.json.email || '').trim();\n  const sent1 = item.json.email_1_sent;\n  if (!email || !sent1) continue;\n  const sentDate = new Date(sent1);\n  const daysDiff = (now - sentDate) / (1000 * 60 * 60 * 24);\n  if (daysDiff >= minDays) {\n    filtered.push(item);\n  }\n}\n\nif (filtered.length === 0) {\n  return [{ json: { _empty: true } }];\n}\nreturn filtered;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-448, 448],
      "id": "filter-wf5",
      "name": "Filter Day 3+ Leads"
