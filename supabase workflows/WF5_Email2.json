      "webhookId": "wf5-wait-001"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst cfg = $('Config').item.json;\n\nconst person = item.kontakt || '';\nconst nachname = (person && person !== 'NA') ? person.split(' ').slice(-1)[0] : null;\nconst anrede = nachname ? `Sehr geehrter Herr ${nachname}` : 'Sehr geehrte Damen und Herren';\nconst firma = item.firma || 'Ihr Betrieb';\nconst subject1 = item.email_1_subject || 'meine letzte Nachricht';\n\nconst subject = `Re: ${subject1}`;\nconst body = `${anrede},\n\nnur eine kurze Nachfrage zu meiner letzten Email — ich wollte sicherstellen, dass sie Sie erreicht hat.\n\nFalls Sie kurz schauen möchten, wie ein modernes Anfrage-Tool für Ihren Betrieb aussehen könnte:\n${cfg.demo_url}\n\nJa oder Nein reicht als Antwort.\n\nBeste Grüße\nKevin Ritz\nRitz AI Solutions\nritz-ai.solutions | +49 151 2975 5134 | kevin@ritz-ai.solutions`;\n\nreturn [{\n  json: {\n    email_to: item.email,\n    email_subject: subject,\n    email_body: body,\n    contact_id: item.id,\n    firma: firma\n  }\n}];"
      },
