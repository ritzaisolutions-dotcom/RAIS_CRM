# Production (default) or Staging — never commit real secrets
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: enable CSP report-only headers (Preview first)
# CSP_REPORT_ONLY=1

# CI / local RLS suite — dedicated staging DB only (never production)
# SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional outbound email (queued in sales.email_messages + timeline touch)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional SMS provider hook (queued in sales.sms_messages + timeline touch)
# SMS_PROVIDER_URL=

# Desktop shell (desktop/): URL of the deployed or local CRM
# RAIS_CRM_URL=http://localhost:3000
