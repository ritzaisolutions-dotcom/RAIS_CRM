# Production (default) or Staging — never commit real secrets
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: enable CSP report-only headers (Preview first)
# CSP_REPORT_ONLY=1

# CI / local RLS suite — dedicated staging DB only (never production)
# SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Outbound email (Nodemailer) — required for real send from CRM
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_PORT=587
# SMTP_SECURE=0

# Inbound email (IMAP poller cron) — Gmail: enable App Password
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASS=
# IMAP_PORT=993
# IMAP_FOLDER=INBOX

# Vercel cron + Settings “Jetzt ausführen” / sync
# CRON_SECRET=long-random-string

# Server-only admin client for cron runners (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional SMS provider hook
# SMS_PROVIDER_URL=
# SMS_WEBHOOK_SECRET=

# Optional AI lead brief on company page (server-only)
# ANTHROPIC_API_KEY=

# Desktop shell (desktop/): URL of the deployed or local CRM
# RAIS_CRM_URL=http://localhost:3000

# Öffentliche CRM-Adresse für Links in Mails (Terminvorschläge, Asana)
# CRM_PUBLIC_URL=https://crm.ritz-ai.solutions
# Absendername für {{absender}} in Vorlagen
# MAIL_SENDER_NAME=Kevin Ritz

# KI-Entwurf im E-Mail-Fenster + KI-Brief (nur serverseitig)
# ANTHROPIC_API_KEY=

# Asana: Aufgaben bei Terminvergabe / manuell aus dem Lead
# ASANA_ACCESS_TOKEN=
# ASANA_PROJECT_GID=   # leer = Projekt „RAIS“
# ASANA_ASSIGNEE=me

# Notion-Sync (Import → Notion-Sync). Interne Integration, Datenbank damit teilen.
NOTION_TOKEN=
# Optional, Standard: Datenbank „ImmoScout Makler Leads“
NOTION_LEADS_DATABASE_ID=
