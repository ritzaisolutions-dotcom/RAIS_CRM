# Vercel Serverless (api/n8n-proxy.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Shared secret: Vercel proxy → n8n WF7–WF12 (Header X-CRM-Proxy-Secret)
N8N_PROXY_SECRET=

# n8n environment (nicht im Repo — nur in n8n Settings)
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_MAPS_API_KEY=
# N8N_PROXY_SECRET=  (gleicher Wert wie Vercel)
