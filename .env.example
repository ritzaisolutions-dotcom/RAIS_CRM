# Production (default) or Staging — never commit real secrets
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: enable CSP report-only headers (Preview first)
# CSP_REPORT_ONLY=1

# CI / local RLS suite — dedicated staging DB only (never production)
# SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Outbound email (Nodemailer) — required for real send from CRM
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_PORT=587
# SMTP_SECURE=0

# Inbound email (IMAP poller cron) — Gmail: enable App Password
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASS=
# IMAP_PORT=993
# IMAP_FOLDER=INBOX

# Vercel cron + Settings “Jetzt ausführen” / sync
# CRON_SECRET=long-random-string

# Server-only admin client for cron runners (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional SMS provider hook
# SMS_PROVIDER_URL=
# SMS_WEBHOOK_SECRET=

# Optional AI lead brief on company page (server-only)
# ANTHROPIC_API_KEY=

# Desktop shell (desktop/): URL of the deployed or local CRM
# RAIS_CRM_URL=http://localhost:3000
